generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  PLUS
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String?          @map("password_hash")
  fullName           String           @map("full_name")
  avatarUrl          String?          @map("avatar_url")
  bio                String?
  role               UserRole         @default(STUDENT)
  subscriptionTier   SubscriptionTier @default(FREE)
  stripeCustomerId   String?          @map("stripe_customer_id")
  razorpayCustomerId String?          @map("razorpay_customer_id")
  xp                 Int              @default(0)
  streak             Int              @default(0)
  lastActiveAt       DateTime?        @map("last_active_at")
  isVerified         Boolean          @default(false) @map("is_verified")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  teacherCourses       Course[]               @relation("TeacherCourses")
  enrollments          Enrollment[]
  progress             Progress[]
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  platformSubscription PlatformSubscription?
  transactions         Transaction[]
  reviews              CourseReview[]
  wishlist             Wishlist[]
  notes                Note[]
  questions            Discussion[]
  replies              DiscussionReply[]
  aiChats              AIChat[]
  submissions          AssignmentSubmission[]
  notifications       Notification[]
  learningGoals     LearningGoal[]

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  isFeatured  Boolean    @default(false) @map("is_featured")
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  courses     Course[]
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("categories")
}

model Course {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  description    String       @db.Text
  thumbnailUrl   String?      @map("thumbnail_url")
  introVideoUrl  String?      @map("intro_video_url")
  price          Decimal      @default(0) @map("price") @db.Decimal(10, 2)
  currency       String       @default("INR")
  discountPrice  Decimal?     @map("discount_price") @db.Decimal(10, 2)
  discountEndsAt DateTime?    @map("discount_ends_at")
  isFree         Boolean      @default(false) @map("is_free")
  isFeatured     Boolean      @default(false) @map("is_featured")
  status         CourseStatus @default(DRAFT)
  categoryId     String       @map("category_id")
  teacherId      String       @map("teacher_id")
  language       String       @default("Tamil")
  level          String       @default("beginner")
  durationMins   Int?         @map("duration_mins")
  totalLessons   Int          @default(0) @map("total_lessons")
  totalStudents  Int          @default(0) @map("total_students")
  totalRatings   Int          @default(0) @map("total_ratings")
  avgRating      Decimal      @default(0) @map("avg_rating") @db.Decimal(3, 2)
  requirements   String?      @map("requirements") @db.Text
  outcomes       String?      @map("outcomes") @db.Text
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  category      Category       @relation(fields: [categoryId], references: [id])
  teacher       User           @relation("TeacherCourses", fields: [teacherId], references: [id])
  sections      Section[]
  enrollments   Enrollment[]
  reviews       CourseReview[]
  wishlist      Wishlist[]
  coupons       CouponCourse[] @relation("CouponCourse")
  certificates  Certificate[]
  learningGoals LearningGoal[]

  @@index([slug])
  @@index([teacherId])
  @@index([categoryId])
  @@index([status])
  @@map("courses")
}

model Section {
  id         String   @id @default(uuid())
  courseId   String   @map("course_id")
  title      String
  order      Int
  isLocked   Boolean  @default(false) @map("is_locked")
  unlockDays Int?     @map("unlock_days")
  createdAt  DateTime @default(now()) @map("created_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("sections")
}

model Lesson {
  id             String     @id @default(uuid())
  sectionId      String     @map("section_id")
  title          String
  order          Int
  type           LessonType @default(VIDEO)
  description    String?    @db.Text
  videoUrl       String?    @map("video_url")
  videoDuration  Int?       @map("video_duration")
  articleContent String?    @map("article_content") @db.Text
  isFree         Boolean    @default(false) @map("is_free")
  isPreview      Boolean    @default(false) @map("is_preview")
  requiresPass   Boolean    @default(false) @map("requires_pass")
  passScore      Int?       @map("pass_score")
  dripUnlockDays Int?       @map("drip_unlock_days")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quiz        Quiz?
  assignment  Assignment?
  liveSession LiveSession?
  progress    Progress[]
  resources   Resource[]
  discussions Discussion[]
  aiChats     AIChat[]

  @@index([sectionId])
  @@map("lessons")
}

model Quiz {
  id               String   @id @default(uuid())
  lessonId         String   @unique @map("lesson_id")
  title            String
  description      String?
  timeLimit        Int?     @map("time_limit")
  passScore        Int      @default(70) @map("pass_score")
  shuffleQuestions Boolean  @default(false) @map("shuffle_questions")
  showResults      Boolean  @default(true) @map("show_results")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id      String @id @default(uuid())
  quizId  String @map("quiz_id")
  text    String
  type    String @default("mcq")
  options Json
  correct Json
  points  Int    @default(1)
  order   Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model QuizAttempt {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  quizId      String            @map("quiz_id")
  answers     Json
  score       Int?
  maxScore    Int?
  passed      Boolean?
  timeTaken   Int?              @map("time_taken")
  status      QuizAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now()) @map("started_at")
  submittedAt DateTime?         @map("submitted_at")

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Assignment {
  id          String    @id @default(uuid())
  lessonId    String    @unique @map("lesson_id")
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  maxScore    Int       @default(100) @map("max_score")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  assignmentId      String    @map("assignment_id")
  content           String    @db.Text
  submissionFileUrl String?   @map("submission_file_url")
  grade             Int?
  feedback          String?
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  gradedAt          DateTime? @map("graded_at")

  user       User       @relation(fields: [userId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assignment_submissions")
}

model LiveSession {
  id              String   @id @default(uuid())
  lessonId        String   @unique @map("lesson_id")
  title           String
  scheduledAt     DateTime @map("scheduled_at")
  durationMins    Int      @map("duration_mins")
  joinUrl         String?  @map("join_url")
  recordingUrl    String?  @map("recording_url")
  status          String   @default("scheduled")
  maxParticipants Int      @default(100) @map("max_participants")
  createdAt       DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("live_sessions")
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  courseId    String           @map("course_id")
  status      EnrollmentStatus @default(ACTIVE)
  progress    Json             @default("{}")
  completedAt DateTime?        @map("completed_at")
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  expireAt    DateTime?        @map("expire_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model Progress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at")
  watchTime   Int      @default(0) @map("watch_time")

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("progress")
}

model Certificate {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  courseId    String   @map("course_id")
  verifyHash  String   @unique @map("verify_hash")
  issuedAt    DateTime @default(now()) @map("issued_at")
  templateUrl String?  @map("template_url")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@map("certificates")
}

model PlatformSubscription {
  id                 String           @id @default(uuid())
  userId             String           @unique @map("user_id")
  tier               SubscriptionTier @default(FREE)
  status             EnrollmentStatus @default(ACTIVE)
  stripeSubId        String?          @map("stripe_sub_id")
  razorpaySubId      String?          @map("razorpay_sub_id")
  currentPeriodStart DateTime?        @map("current_period_start")
  currentPeriodEnd   DateTime?        @map("current_period_end")
  cancelAtPeriodEnd  Boolean          @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?        @map("cancelled_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("platform_subscriptions")
}

model Transaction {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  amount               Decimal  @map("amount") @db.Decimal(10, 2)
  currency             String   @default("INR")
  gateway              String
  gatewayTransactionId String?  @map("gateway_transaction_id")
  gatewayOrderId       String?  @map("gateway_order_id")
  status               String   @default("pending")
  type                 String
  metadata             Json?
  createdAt            DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("transactions")
}

model CourseReview {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  courseId        String    @map("course_id")
  rating          Int
  title           String?
  body            String?   @db.Text
  isVerified      Boolean   @default(false) @map("is_verified")
  instructorReply String?   @map("instructor_reply")
  repliedAt       DateTime? @map("replied_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@map("course_reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("wishlists")
}

model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  timestamp Int?     @map("timestamp")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lessonId])
  @@map("notes")
}

model Discussion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  title     String
  body      String   @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned")
  upvotes   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id])
  lesson  Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]

  @@index([lessonId])
  @@map("discussions")
}

model DiscussionReply {
  id           String   @id @default(uuid())
  discussionId String   @map("discussion_id")
  userId       String   @map("user_id")
  body         String   @db.Text
  upvotes      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@map("discussion_replies")
}

model Resource {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  title     String
  type      String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model LearningGoal {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  title       String
  description String?
  targetDate  DateTime? @map("target_date")
  targetLessons Int?    @map("target_lessons")
  completed   Boolean   @default(false)
  completedAt  DateTime?  @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@map("learning_goals")
}

model AIChat {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  lessonId   String?  @map("lesson_id")
  courseId   String?  @map("course_id")
  messages   Json
  tokensUsed Int      @default(0) @map("tokens_used")
  createdAt  DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  lesson Lesson? @relation(fields: [lessonId], references: [id])

  @@index([userId])
  @@map("ai_chats")
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String
  discount    Decimal   @db.Decimal(10, 2)
  minPurchase Decimal?  @map("min_purchase") @db.Decimal(10, 2)
  maxUses     Int?      @map("max_uses")
  usesCount   Int       @default(0) @map("uses_count")
  validFrom   DateTime? @map("valid_from")
  validUntil  DateTime? @map("valid_until")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  courses CouponCourse[]

  @@map("coupons")
}

model CouponCourse {
  id       String @id @default(uuid())
  couponId String @map("coupon_id")
  courseId String @map("course_id")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course Course @relation("CouponCourse", fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([couponId, courseId])
  @@map("coupon_courses")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String?  @db.Text
  type      String   @default("GENERAL")
  link      String?
  image     String?
  read      Boolean  @default(false)
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}
